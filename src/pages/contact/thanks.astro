---
// Return page for the contact form. UD's Forms Data Processor sends the visitor
// here after it has stored and emailed their message. Register this page's full
// URL as the form's "Return page" in FDP.
import MainLayout from '@/layouts/MainLayout.astro';
import PrimaryCTA from '@components/ui/buttons/PrimaryCTA.astro';
import CwIcon from '@components/ui/icons/CwIcon.astro';
import { getCopy } from '@/copy';

const copy = getCopy('en').contact;
---

<MainLayout title={copy.thanksTitle} description={copy.thanksBody}>
  <section class="mx-auto flex min-h-[60svh] max-w-xl flex-col items-center justify-center px-4 py-20 text-center">
    <span class="flex size-14 items-center justify-center rounded-2xl bg-orange-400/10 text-orange-400" aria-hidden="true">
      <CwIcon name="mail" class="size-7" />
    </span>
    <h1 class="mt-6 text-3xl font-bold tracking-tight text-neutral-800 md:text-4xl">{copy.thanksTitle}</h1>
    <p class="mt-3 text-lg text-pretty text-neutral-600">{copy.thanksBody}</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <PrimaryCTA title={copy.thanksBack} url="/" />
      <a
        href="/docs/"
        class="inline-flex items-center justify-center rounded-lg border border-neutral-300 px-4 py-3 text-sm font-bold text-neutral-700 transition-colors hover:bg-neutral-100"
      >
        {copy.thanksGuides}
      </a>
    </div>
  </section>
</MainLayout>

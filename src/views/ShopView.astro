---
import { reveal, revealImage, delay } from '@utils/motion';
import { Image } from 'astro:assets';
import MainLayout from '@/layouts/MainLayout.astro';
import CwIcon from '@components/ui/icons/CwIcon.astro';
import Icon from '@components/ui/icons/Icon.astro';
import PrimaryCTA from '@components/ui/buttons/PrimaryCTA.astro';
import SecondaryCTA from '@components/ui/buttons/SecondaryCTA.astro';
import PartsList from '@components/sections/cosmicwatch/PartsList.astro';
import { products, groups } from '@data/shop';
import { CONTACT_EMAIL } from '@data/navigation';
import { getCopy } from '@/copy';
import type { MarketingLocale } from '@utils/locale';

// UD requires Treasury-approved payment tools (Interim Payment Card Policy 3-26), so orders go by email
// until a provider is approved; render its button into #pay then.
interface Props {
  locale: MarketingLocale;
}
const { locale } = Astro.props;
const copy = getCopy(locale).shop;
const money = (n: number | null) => (n == null ? copy.priceOnRequest : `$${n.toFixed(2)}`);
// the template's TextInput classes
const field =
  'block w-full rounded-lg border border-neutral-200 bg-neutral-50 px-4 py-3 text-sm text-neutral-700 focus:border-neutral-200 focus:ring-3 focus:ring-neutral-400 focus:outline-hidden dark:border-neutral-600 dark:bg-neutral-700/30 dark:text-neutral-300 dark:focus:ring-1';
const catalog = products.map(p => ({ id: p.id, name: p.name, price: p.price }));
---

<MainLayout title={copy.title} description={copy.metaDescription} ogTitle={copy.ogTitle}>
  <section class="mx-auto max-w-[85rem] px-4 pt-10 pb-4 sm:px-6 lg:px-8 lg:pt-14 2xl:max-w-full">
    <div class="max-w-3xl">
      <h1 class:list={['block text-3xl font-bold tracking-tight text-balance text-neutral-800 sm:text-4xl md:text-5xl lg:text-6xl dark:text-neutral-200', reveal]}>{copy.heading}</h1>
      <p class="mt-3 text-lg text-pretty text-neutral-700 lg:w-4/5 dark:text-neutral-400">{copy.subTitle}</p>
    </div>
  </section>

  <div class="mx-auto grid max-w-[85rem] gap-10 px-4 pb-10 sm:px-6 lg:grid-cols-[1fr_22rem] lg:px-8 2xl:max-w-full">
    <div>
      {groups.map(group => (
        <section class="py-6" aria-labelledby={`g-${group.id}`}>
          <h2 id={`g-${group.id}`} class="text-2xl font-bold text-balance text-neutral-800 md:text-4xl md:leading-tight dark:text-neutral-200">{group.title}</h2>
          <p class="mt-1 text-pretty text-neutral-600 dark:text-neutral-400">{group.body}</p>
          <div class="mt-6 grid gap-6 md:grid-cols-2">
            {products.filter(p => p.group === group.id).map((p, i) => (
              <article class:list={['flex flex-col overflow-hidden surface', reveal, delay(i % 2)]} data-product={p.id}>
                <div class:list={['flex aspect-[16/10] items-center justify-center overflow-hidden', p.cutout ? 'bg-neutral-200/60 dark:bg-white/[.05]' : 'bg-night']}>
                  <Image src={p.image} alt={p.imageAlt} width={700} class:list={['size-full', p.cutout ? 'cw-float object-contain p-6' : 'object-cover']} />
                </div>
                <div class="flex grow flex-col p-5 sm:p-6">
                  <div class="flex items-baseline justify-between gap-4">
                    <h3 class="text-xl font-bold text-neutral-800 dark:text-neutral-200">{p.name}</h3>
                    <p class="shrink-0 text-sm font-bold text-orange-400 dark:text-orange-300">{money(p.price)}</p>
                  </div>
                  <p class="mt-2 text-sm text-pretty text-neutral-600 dark:text-neutral-400">{p.summary}</p>
                  <ul class="mt-4 space-y-1.5 text-sm text-neutral-600 dark:text-neutral-400">
                    {p.includes.map(item => (
                      <li class="flex gap-x-2"><Icon name="checkCircle" class="mt-0.5 size-4 shrink-0 text-orange-400 dark:text-orange-300" />{item}</li>
                    ))}
                  </ul>
                  <div class="mt-auto flex flex-wrap items-end gap-3 pt-6">
                    {p.options && (
                      <label class="text-sm text-neutral-700 dark:text-neutral-300">
                        <span class="mb-1 block">{p.options.label}</span>
                        <select data-option class={field}>
                          {p.options.values.map(v => <option>{v}</option>)}
                        </select>
                      </label>
                    )}
                    <label class="text-sm text-neutral-700 dark:text-neutral-300">
                      <span class="mb-1 block">{copy.qty}</span>
                      <input data-qty type="number" min="1" max="200" value="1" class={`${field} w-20 tabular-nums`} />
                    </label>
                    <span class="ms-auto">
                      <PrimaryCTA title={copy.add} type="button" data-add />
                    </span>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </section>
      ))}

      <section class:list={['mt-4 flex flex-col gap-5 surface p-6 sm:flex-row sm:items-start sm:p-8', reveal]}>
        <CwIcon name="people" class="mt-1 size-8 shrink-0 text-orange-400 dark:text-orange-300" />
        <div>
          <h2 class="text-lg font-bold text-neutral-800 dark:text-neutral-200">{copy.quarknetTitle}</h2>
          <p class="mt-1 max-w-2xl text-pretty text-neutral-600 dark:text-neutral-400">{copy.quarknetBody}</p>
          <a class="group mt-3 inline-flex items-center gap-x-1 text-sm font-medium text-orange-400 decoration-2 hover:underline dark:text-orange-300" href="https://quarknet.org/" target="_blank" rel="noopener noreferrer">quarknet.org <Icon name="arrowRight" class="size-4 shrink-0 transition duration-300 group-hover:translate-x-1" /></a>
        </div>
      </section>
    </div>

    <aside class="lg:pt-6" aria-labelledby="cart-title">
      <div id="cart" class="surface p-5 lg:sticky lg:top-28" data-catalog={JSON.stringify(catalog)} data-email={CONTACT_EMAIL}>
        <h2 id="cart-title" class="flex items-center gap-2 text-lg font-bold text-neutral-800 dark:text-neutral-200">
          {copy.cartTitle} <span id="cart-count" class="rounded-full bg-orange-400 px-2 py-0.5 text-xs text-neutral-50 tabular-nums">0</span>
        </h2>
        <p id="cart-empty" class="mt-4 text-sm text-neutral-600 dark:text-neutral-400">{copy.cartEmpty}</p>
        <ul id="cart-lines" class="mt-2 divide-y divide-neutral-300 dark:divide-neutral-700"></ul>
        <p id="cart-total" class="mt-3 hidden border-t border-neutral-300 pt-3 text-sm text-neutral-600 dark:border-neutral-700 dark:text-neutral-300"></p>

        <form id="order" class="mt-5 hidden space-y-4" novalidate>
          <label class="block text-sm text-neutral-700 dark:text-neutral-300"><span class="mb-2 block">{copy.name}</span>
            <input name="name" required autocomplete="name" class={field} />
          </label>
          <label class="block text-sm text-neutral-700 dark:text-neutral-300"><span class="mb-2 block">{copy.email}</span>
            <input name="email" type="email" required autocomplete="email" class={field} />
          </label>
          <label class="block text-sm text-neutral-700 dark:text-neutral-300"><span class="mb-2 block">{copy.org}</span>
            <input name="org" autocomplete="organization" class={field} />
          </label>
          <label class="block text-sm text-neutral-700 dark:text-neutral-300"><span class="mb-2 block">{copy.ship}</span>
            <textarea name="ship" rows="2" autocomplete="street-address" class={field}></textarea>
          </label>
          <p id="order-error" class="hidden text-sm text-red-700 dark:text-red-400" role="alert"></p>
          <div class="grid gap-3">
            <PrimaryCTA title={copy.send} type="submit" />
            <SecondaryCTA title={copy.copyOrder} type="button" id="order-copy" />
          </div>
          <p id="order-status" class="text-sm text-neutral-600 dark:text-neutral-400" aria-live="polite"></p>
          <div id="pay" class="rounded-lg bg-neutral-200/70 p-3 text-xs text-pretty text-neutral-600 dark:bg-white/[.05] dark:text-neutral-400">{copy.payNote}</div>
        </form>
      </div>
    </aside>
  </div>

  <PartsList />
</MainLayout>

<script>
  type Line = { id: string; option: string; qty: number };
  const cartEl = document.getElementById('cart')!;
  const catalog: { id: string; name: string; price: number | null }[] = JSON.parse(cartEl.dataset.catalog!);
  const email = cartEl.dataset.email!;
  const KEY = 'cw-cart';
  const $ = (id: string) => document.getElementById(id)!;

  const readCart = (): Line[] => {
    try {
      return JSON.parse(localStorage.getItem(KEY) || '[]');
    } catch {
      return [];
    }
  };
  let cart: Line[] = readCart();
  const save = () => {
    try {
      localStorage.setItem(KEY, JSON.stringify(cart));
    } catch {
      /* storage can be unavailable; the cart still works for this visit */
    }
  };
  const label = (l: Line) => {
    const p = catalog.find(c => c.id === l.id);
    return `${p?.name ?? l.id}${l.option ? ` (${l.option})` : ''}`;
  };

  function render() {
    const lines = $('cart-lines');
    lines.innerHTML = '';
    for (const [i, l] of cart.entries()) {
      const li = document.createElement('li');
      li.className = 'flex items-center gap-3 py-3 text-sm';
      const name = document.createElement('span');
      name.className = 'grow text-neutral-800 dark:text-neutral-200';
      name.textContent = label(l);
      const qty = document.createElement('input');
      qty.type = 'number';
      qty.min = '1';
      qty.value = String(l.qty);
      qty.setAttribute('aria-label', `Quantity of ${label(l)}`);
      qty.className = 'w-16 rounded-lg border border-neutral-200 bg-neutral-50 px-2 py-1.5 text-neutral-700 tabular-nums dark:border-neutral-600 dark:bg-neutral-700/30 dark:text-neutral-300';
      qty.addEventListener('change', () => {
        l.qty = Math.max(1, parseInt(qty.value, 10) || 1);
        save();
        render();
      });
      const rm = document.createElement('button');
      rm.type = 'button';
      rm.textContent = 'Remove';
      rm.className = 'text-neutral-500 decoration-2 hover:text-orange-400 hover:underline dark:hover:text-orange-300';
      rm.addEventListener('click', () => {
        cart.splice(i, 1);
        save();
        render();
      });
      li.append(name, qty, rm);
      lines.append(li);
    }
    const count = cart.reduce((s, l) => s + l.qty, 0);
    $('cart-count').textContent = String(count);
    $('cart-empty').classList.toggle('hidden', cart.length > 0);
    $('order').classList.toggle('hidden', cart.length === 0);
    const priced = cart.every(l => catalog.find(c => c.id === l.id)?.price != null);
    const total = $('cart-total');
    total.classList.toggle('hidden', cart.length === 0);
    total.textContent = priced
      ? `Total: $${cart.reduce((s, l) => s + (catalog.find(c => c.id === l.id)!.price as number) * l.qty, 0).toFixed(2)} plus shipping`
      : 'Prices for these items are on request. The lab replies with a quote and invoice.';
  }

  document.querySelectorAll<HTMLElement>('[data-product]').forEach(card => {
    card.querySelector('[data-add]')!.addEventListener('click', e => {
      const id = card.dataset.product!;
      const option = (card.querySelector('[data-option]') as HTMLSelectElement | null)?.value ?? '';
      const qty = Math.max(1, parseInt((card.querySelector('[data-qty]') as HTMLInputElement).value, 10) || 1);
      const existing = cart.find(l => l.id === id && l.option === option);
      if (existing) existing.qty += qty;
      else cart.push({ id, option, qty });
      save();
      render();
      const btn = e.currentTarget as HTMLButtonElement;
      const text = btn.textContent;
      btn.textContent = 'Added';
      setTimeout(() => (btn.textContent = text), 1200);
    });
  });

  function orderText(form: HTMLFormElement) {
    const f = new FormData(form);
    return [
      'CosmicWatch order request',
      '',
      ...cart.map(l => `- ${l.qty} × ${label(l)}`),
      '',
      `Name: ${f.get('name') || ''}`,
      `Email: ${f.get('email') || ''}`,
      `School or organization: ${f.get('org') || ''}`,
      `Ship to: ${f.get('ship') || ''}`,
    ].join('\n');
  }

  const form = $('order') as HTMLFormElement;
  form.addEventListener('submit', e => {
    e.preventDefault();
    const err = $('order-error');
    const f = new FormData(form);
    if (!String(f.get('name')).trim() || !/^\S+@\S+\.\S+$/.test(String(f.get('email')))) {
      err.textContent = 'Add your name and a valid email so the lab can reply.';
      err.classList.remove('hidden');
      return;
    }
    err.classList.add('hidden');
    const body = orderText(form);
    window.location.href = `mailto:${email}?subject=${encodeURIComponent('CosmicWatch order request')}&body=${encodeURIComponent(body)}`;
    $('order-status').textContent = `Your email app should open with the order filled in. If it does not, use "Copy order" and send it to ${email}.`;
  });
  $('order-copy').addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(orderText(form));
      $('order-status').textContent = `Order copied. Paste it into an email to ${email}.`;
    } catch {
      $('order-status').textContent = `Copying is blocked here. Email ${email} with the items listed above.`;
    }
  });

  render();
</script>

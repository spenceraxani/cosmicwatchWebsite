---
import MainLayout from '@/layouts/MainLayout.astro';
import ContactSection from '@components/sections/misc/ContactSection.astro';
import FAQ from '@components/sections/misc/FAQ.astro';
import PeopleSection from '@components/sections/misc/PeopleSection.astro';
import { getCopy } from '@/copy';
import type { MarketingLocale } from '@utils/locale';

interface Props {
  locale: MarketingLocale;
}

const { locale } = Astro.props;
const t = getCopy(locale);
const copy = t.contact;
---

<MainLayout
  title={copy.title}
  description={copy.metaDescription}
  ogTitle={copy.ogTitle}
>
  <ContactSection />
  <PeopleSection title={t.people.heading} subTitle={t.people.subTitle} />
  <div id="faq" class="scroll-mt-24">
    <FAQ title={copy.faqTitle} faqs={t.data.faqs} />
  </div>
</MainLayout>

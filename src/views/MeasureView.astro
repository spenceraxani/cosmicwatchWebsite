---
import { reveal, revealImage, delay } from '@utils/motion';
import MainLayout from '@/layouts/MainLayout.astro';
import CwIcon from '@components/ui/icons/CwIcon.astro';

// The same plots, in the same order, as the CosmicWatch GUI (GUI/GUI.py on GitHub).
const tabs = [
  {
    id: 'rate',
    label: 'Rate',
    doc: '/docs/guides/example-measurements/tested-measurements/a-full-sky-cosmic-ray-muon-measurement/',
    blurb:
      'Count rate over time for all, non-coincident and coincident events.',
  },
  {
    id: 'adc',
    label: 'ADC',
    doc: '/docs/guides/example-measurements/tested-measurements/reducing-radioactive-backgrounds/',
    blurb: 'Pulse-height spectrum in ADC counts.',
  },
  {
    id: 'sipm',
    label: 'SiPM',
    doc: '/docs/guides/instruction-manual/the-cosmicwatch-desktop-muon-detector-v3x/',
    blurb: 'Pulse-height spectrum in SiPM peak voltage.',
  },
  {
    id: 'pressure',
    label: 'Pressure',
    doc: '/docs/guides/example-measurements/tested-measurements/correlation-between-the-cosmic-ray-muon-rate-and-atmospheric-pressure/',
    blurb: 'Air pressure over time.',
  },
  {
    id: 'temperature',
    label: 'Temperature',
    doc: '/docs/guides/example-measurements/tested-measurements/correlation-between-the-cosmic-ray-muon-rate-and-atmospheric-pressure/',
    blurb: 'Temperature inside the case over time.',
  },
  {
    id: 'accel',
    label: 'Linear Acceleration',
    doc: '/docs/guides/example-measurements/tested-measurements/cosmic-ray-muon-angular-dependence/',
    blurb: 'Acceleration along X, Y and Z.',
  },
  {
    id: 'ratedist',
    label: 'Rate Distribution',
    doc: '/docs/guides/example-measurements/tested-measurements/a-true-random-number-generator/',
    blurb:
      'A histogram of the number of events in each time bin, with a Poisson fit. If the detector is working properly, χ²/dof should be close to 1.',
  },
  {
    id: 'dt',
    label: 'Δt Distribution',
    doc: '/docs/guides/example-measurements/tested-measurements/a-true-random-number-generator/',
    blurb:
      'A histogram of the time between consecutive events, with an exponential fit. A spike at very short times usually indicates that there is electrical noise.',
  },
];
// Card, button and input styles shared with the rest of the site
const box = 'surface';
const inner =
  'md:border-l md:border-neutral-300 md:pl-6 md:first:border-l-0 md:first:pl-0 dark:md:border-neutral-700';
const btn =
  'inline-flex items-center justify-center gap-x-2 rounded-lg border border-neutral-200 bg-neutral-300 px-4 py-2.5 text-center text-sm font-medium text-neutral-600 shadow-xs ring-zinc-500 outline-hidden transition duration-300 hover:bg-neutral-400/50 hover:text-neutral-600 focus-visible:ring-3 disabled:pointer-events-none disabled:opacity-50 dark:border-neutral-700 dark:bg-zinc-700 dark:text-neutral-300 dark:ring-zinc-200 dark:hover:bg-zinc-600';
const primary =
  'inline-flex items-center justify-center gap-x-2 rounded-lg border border-transparent bg-orange-400 px-4 py-2.5 text-sm font-bold text-neutral-50 ring-zinc-500 outline-hidden transition duration-300 hover:bg-orange-500 focus-visible:ring-3 disabled:pointer-events-none disabled:opacity-50 dark:ring-zinc-200';
const field =
  'mt-2 rounded-lg border border-neutral-200 bg-neutral-50 px-4 py-2.5 text-sm text-neutral-700 focus:border-neutral-200 focus:ring-3 focus:ring-neutral-400 focus:outline-hidden dark:border-neutral-600 dark:bg-neutral-700/30 dark:text-neutral-300 dark:placeholder:text-neutral-400 dark:focus:ring-1';
---

<MainLayout
  title="Measure"
  description="Connect a CosmicWatch detector over USB or open a data file and get the same plots as the CosmicWatch GUI: rate, ADC and SiPM spectra, pressure, temperature, motion, and rate and Δt distributions. Download CSV or a PDF report."
  ogTitle="Measure | CosmicWatch"
>
  <section class="mx-auto max-w-[85rem] px-4 pt-10 pb-8 sm:px-6 lg:px-8 lg:pt-14 lg:pb-10 2xl:max-w-full">
    <h1
      class:list={[
        'block text-2xl font-bold tracking-tight text-balance text-neutral-800 md:text-4xl md:leading-tight dark:text-neutral-200',
        reveal,
      ]}
    >
      Measure With CosmicWatch
      <span
        id="m-title-name"
        class="text-orange-400 dark:text-orange-300"
      ></span>
    </h1>
  </section>

  <div
    id="measure"
    class="mx-auto max-w-[85rem] space-y-6 px-4 pb-20 sm:px-6 lg:px-8 2xl:max-w-full"
  >
    <section class:list={[box, 'p-5 sm:p-6', reveal]} aria-label="Data source">
      <div class="grid gap-6 md:grid-cols-3">
        <div class={inner}>
          <CwIcon
            name="usb"
            class="size-8 text-orange-400 dark:text-orange-300"
          />
          <h2 class="mt-3 text-lg font-bold text-neutral-800 dark:text-neutral-200">
            Connect a Detector
          </h2>
          <div class="mt-4 flex flex-wrap gap-2">
            <button type="button" id="m-connect" class={primary}>
              Connect detector
            </button>
            <button type="button" id="m-save" class={btn} hidden>
              Save data (.txt)
            </button>
          </div>
          <p
            id="m-noserial"
            class="mt-3 hidden text-sm text-neutral-600 dark:text-neutral-400"
          >
            This browser cannot open USB serial ports. Use Chrome or Edge on a
            computer, or open a file instead.
          </p>
        </div>
        <div
          id="m-drop"
          class:list={[
            inner,
            'rounded-lg ring-orange-400 ring-offset-4 ring-offset-neutral-100 transition-shadow dark:ring-offset-neutral-800',
          ]}
        >
          <CwIcon
            name="datafile"
            class="size-8 text-orange-400 dark:text-orange-300"
          />
          <h2 class="mt-3 text-lg font-bold text-neutral-800 dark:text-neutral-200">
            Open a Data File
          </h2>
          <label class:list={[btn, 'mt-4 cursor-pointer']}>
            Choose file
            <input
              id="m-file"
              type="file"
              accept=".txt,.csv,.gz,text/plain"
              class="sr-only"
            />
          </label>
        </div>
        <div class={inner}>
          <CwIcon
            name="coincidence"
            class="size-8 text-orange-400 dark:text-orange-300"
          />
          <h2 class="mt-3 text-lg font-bold text-neutral-800 dark:text-neutral-200">
            Use the Sample Run
          </h2>
          <div class="mt-4 flex flex-wrap items-center gap-3">
            <button type="button" id="m-sample" class={btn}>
              Load sample
            </button>
            <a
              id="m-sample-file"
              href="/data/axlab-sample-12h.txt.gz"
              class="text-sm font-medium text-orange-400 decoration-2 hover:underline dark:text-orange-300"
            >
              Download it (2.8 MB)
            </a>
          </div>
        </div>
      </div>
      <div
        id="m-status-row"
        class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-neutral-200 pt-4 text-sm dark:border-neutral-700"
        hidden
      >
        <p
          id="m-status"
          class="text-neutral-600 dark:text-neutral-400"
          aria-live="polite"
        ></p>
        <progress
          id="m-progress"
          class="hidden h-1.5 w-40 accent-orange-400"
          max="1"
          value="0"
        ></progress>
      </div>
    </section>

    <dl
      id="m-summary"
      class="surface grid grid-cols-2 gap-y-2 py-2 sm:grid-cols-3 lg:grid-cols-6 lg:divide-x lg:divide-neutral-300 dark:lg:divide-neutral-700"
    >
      {[
        ['duration', 'Run Length'],
        ['events', 'Events'],
        ['rate', 'Rate'],
        ['coinc', 'Coincident Rate'],
        ['temp', 'Temperature'],
        ['press', 'Pressure'],
      ].map(([id, label]) => (
        <div class="flex flex-col-reverse px-5 py-3">
          <dt class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">
            {label}
          </dt>
          <dd
            id={`s-${id}`}
            class="text-2xl font-bold text-orange-400 tabular-nums dark:text-orange-300"
          >
            –
          </dd>
        </div>
      ))}
    </dl>

    <section
      class:list={[box, 'overflow-hidden', reveal]}
      aria-label="Measurements"
    >
      <div class="flex flex-wrap items-center justify-between gap-4 border-b border-neutral-200 px-4 py-3 sm:px-6 dark:border-neutral-700">
        <nav
          role="tablist"
          aria-label="Measurement"
          class="flex gap-1 overflow-x-auto"
        >
          {tabs.map((t, i) => (
            <button
              type="button"
              role="tab"
              id={`tab-${t.id}`}
              data-tab={t.id}
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-controls="m-panel"
              class="shrink-0 rounded-lg px-4 py-2.5 text-sm font-bold whitespace-nowrap text-neutral-600 outline-hidden ring-zinc-500 transition duration-300 hover:bg-neutral-200 focus-visible:ring-3 aria-selected:bg-neutral-200 aria-selected:text-orange-400 dark:text-neutral-400 dark:ring-zinc-200 dark:hover:bg-neutral-700 dark:aria-selected:bg-neutral-700 dark:aria-selected:text-orange-300"
            >
              {t.label}
            </button>
          ))}
        </nav>
      </div>

      <div
        id="m-panel"
        role="tabpanel"
        aria-labelledby="tab-rate"
        class="p-4 sm:p-6"
      >
        {tabs.map((t, i) => (
          <div data-blurb={t.id} hidden={i !== 0}>
            <p class="max-w-3xl text-sm text-pretty text-neutral-600 dark:text-neutral-400">
              {t.blurb}
            </p>
          </div>
        ))}
        <div class="mt-4 flex flex-wrap items-end gap-4 text-sm text-neutral-600 dark:text-neutral-400">
          <label data-ctl="bin" class="block">
            Bin time
            <select id="m-bin" class:list={[field, 'block']}>
              <option value="auto">Automatic</option>
              <option value="30">30 s</option>
              <option value="60">60 s</option>
              <option value="120">120 s</option>
              <option value="180">180 s</option>
              <option value="240">240 s</option>
              <option value="600">600 s</option>
              <option value="custom">Custom</option>
            </select>
          </label>
          <label id="m-bin-custom-wrap" class="block" hidden>
            Seconds
            <input
              id="m-bin-custom"
              type="number"
              min="1"
              step="1"
              value="300"
              class:list={[field, 'block w-28 tabular-nums']}
            />
          </label>
          <fieldset class="flex items-end gap-2">
            <legend class="sr-only">ADC Window (Applies to Every Plot)</legend>
            <label class="block">
              ADC min
              <input
                id="m-adc-min"
                type="number"
                min="0"
                max="4095"
                step="1"
                value="0"
                class:list={[field, 'block w-24 tabular-nums']}
              />
            </label>
            <label class="block">
              ADC max
              <input
                id="m-adc-max"
                type="number"
                min="0"
                max="4095"
                step="1"
                value="4095"
                class:list={[field, 'block w-24 tabular-nums']}
              />
            </label>
            <button type="button" id="m-adc-reset" class={btn}>
              Reset
            </button>
          </fieldset>
          <div class="ms-auto flex flex-wrap gap-2">
            <button type="button" id="m-csv" class={btn} disabled>
              Download CSV
            </button>
            <button type="button" id="m-copy" class={btn} disabled>
              Copy CSV
            </button>
            <button type="button" id="m-pdf" class={primary} disabled>
              PDF report
            </button>
          </div>
        </div>
        <div class="relative mt-4 h-80 sm:h-[26rem]">
          <canvas
            id="m-chart"
            aria-label="Measurement chart"
            role="img"
          ></canvas>
          <p
            id="m-empty"
            class="absolute inset-0 flex items-center justify-center rounded-lg bg-neutral-50 px-6 text-center text-sm text-neutral-500 dark:bg-white/[.04] dark:text-neutral-400"
          >
            Connect a detector, open a file or load the sample run to see this
            measurement.
          </p>
        </div>
        <p
          id="m-result"
          class="mt-4 min-h-6 font-bold text-neutral-800 dark:text-neutral-200"
          aria-live="polite"
        ></p>
      </div>
    </section>

    <details open class:list={[box, 'p-5 sm:p-6', reveal]}>
      <summary class="cursor-pointer text-lg font-bold text-neutral-800 hover:text-neutral-500 dark:text-neutral-200 dark:hover:text-neutral-400">
        Live .txt Entries From the Detector
      </summary>
      <pre
        id="m-raw"
        class="mt-3 h-[28rem] overflow-auto rounded-lg bg-night p-3 font-mono text-xs leading-relaxed text-neutral-300"
      >No data yet.</pre>
    </details>
  </div>
</MainLayout>

<script>
  import { initMeasure } from '../scripts/measure/main';
  initMeasure();
</script>

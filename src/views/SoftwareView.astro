---
import { reveal, revealImage, delay } from '@utils/motion';
import { Image } from 'astro:assets';
import CwIcon from '@components/ui/icons/CwIcon.astro';
import PrimaryCTA from '@components/ui/buttons/PrimaryCTA.astro';
import MainLayout from '@/layouts/MainLayout.astro';
import guiImg from '@images/cw/gui-screenshot.jpg';
import { REPO_URL } from '@data/navigation';
import { getCopy } from '@/copy';
import type { MarketingLocale } from '@utils/locale';

interface Props {
  locale: MarketingLocale;
}

const { locale } = Astro.props;
const copy = getCopy(locale).software;

// TODO: once the lab publishes GitHub Releases with packaged GUI builds
// (GUI/GUI.spec is already a PyInstaller spec), point these at the release assets.
const downloads = {
  repoZip: `${REPO_URL}/archive/refs/heads/main.zip`,
  gui: `${REPO_URL}/tree/main/GUI`,
  firmwareFolder: `${REPO_URL}/tree/main/Firmware`,
  firmware: `${REPO_URL}/raw/main/Firmware/CosmicWatch_v3X.1.1.52.uf2`,
  importData: `${REPO_URL}/blob/main/Data/import_data.py`,
  plot: `${REPO_URL}/blob/main/Data/plot.py`,
};

const card = 'flex flex-col surface p-6 sm:p-8';
const btn =
  'group inline-flex items-center justify-center gap-x-2 rounded-lg border border-transparent bg-orange-400 px-4 py-3 text-sm font-bold text-neutral-50 ring-zinc-500 outline-hidden transition duration-300 hover:bg-orange-500 focus-visible:ring-3 2xl:text-base dark:ring-zinc-200';
const link =
  'font-medium text-orange-400 decoration-2 hover:underline dark:text-orange-300';
---

<MainLayout
  title={copy.title}
  description={copy.metaDescription}
  ogTitle={copy.ogTitle}
>
  <section class="mx-auto max-w-[85rem] px-4 pt-10 pb-6 sm:px-6 lg:px-8 lg:pt-14 2xl:max-w-full">
    <h1 class:list={['block text-3xl font-bold tracking-tight text-balance text-neutral-800 sm:text-4xl md:text-5xl lg:text-6xl dark:text-neutral-200', reveal]}>
      {copy.heading}
    </h1>
    <p class="mt-3 max-w-2xl text-lg text-pretty text-neutral-700 dark:text-neutral-400">
      {copy.subTitle}
    </p>
  </section>

  <section class="mx-auto grid max-w-[85rem] gap-10 px-4 py-10 sm:px-6 lg:grid-cols-2 lg:items-center lg:px-8 2xl:max-w-full">
    <div>
      <CwIcon name="gui" class="size-10 text-orange-400 dark:text-orange-300" />
      <h2 class="mt-4 text-2xl font-bold text-balance text-neutral-800 md:text-4xl md:leading-tight dark:text-neutral-200">
        CosmicWatch GUI
      </h2>
      <p class="mt-4 text-pretty text-neutral-600 dark:text-neutral-400">
        Plots the count rate, pulse-height spectrum, temperature, pressure and motion live from a detector on USB, or from a file off the microSD card. Works on Windows, macOS and Linux.
      </p>
      <ol class="mt-5 list-decimal space-y-2 ps-5 text-neutral-700 dark:text-neutral-300">
        <li>Install <a class={link} href="https://www.python.org/downloads/" target="_blank" rel="noopener noreferrer">Python 3.8 or newer</a>.</li>
        <li>Download the CosmicWatch files and open the <code>GUI</code> folder.</li>
        <li>Run <code>install.bat</code> on Windows, or <code>bash install.sh</code> on macOS and Linux.</li>
        <li>Start it with <code>python GUI.py</code>.</li>
      </ol>
      <div class="mt-6 flex flex-wrap items-center gap-4">
        <a class={btn} href={downloads.repoZip}>Download (.zip)</a>
        <a class={link} href={downloads.gui} target="_blank" rel="noopener noreferrer">View the GUI folder</a>
      </div>
    </div>
    <Image src={guiImg} alt="The CosmicWatch GUI plotting a live run" width={1100} class="w-full rounded-xl" loading="eager" />
  </section>

  <section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 2xl:max-w-full">
    <div class:list={['flex flex-col gap-6 surface p-6 sm:flex-row sm:items-center sm:p-10', reveal]}>
      <CwIcon name="usb" class="size-10 shrink-0 text-orange-400 dark:text-orange-300" />
      <div class="grow">
        <h2 class="text-2xl font-bold text-neutral-800 md:text-3xl dark:text-neutral-200">No install? Use the Measure page</h2>
        <p class="mt-2 max-w-2xl text-pretty text-neutral-600 dark:text-neutral-400">
          Plug the detector into USB and read it straight from Chrome or Edge, or open a file it recorded. Plot rate, pulse height, pressure and temperature trends, event timing and tilt, and send live summaries to a webhook.
        </p>
      </div>
      <span class="shrink-0"><PrimaryCTA title="Open Measure" url="/measure" /></span>
    </div>
  </section>

  <section class="mx-auto grid max-w-[85rem] gap-6 px-4 py-10 sm:px-6 md:grid-cols-2 lg:px-8 lg:py-14 2xl:max-w-full">
    <div class:list={[card, reveal]}>
      <CwIcon name="firmware" class="size-9 text-orange-400 dark:text-orange-300" />
      <h2 class="mt-4 text-2xl font-bold text-neutral-800 dark:text-neutral-200">v3X firmware 1.1.52</h2>
      <p class="mt-3 grow text-pretty text-neutral-600 dark:text-neutral-400">
        Hold BOOTSEL on the Pico, plug it in, and drag the <code>.uf2</code> file onto the drive that appears. The <a class={link} href="/github">GitHub page</a> always shows the newest version.
      </p>
      <div class="mt-6 flex flex-wrap items-center gap-4">
        <a class={btn} href={downloads.firmware}>Download .uf2</a>
        <a class={link} href={downloads.firmwareFolder} target="_blank" rel="noopener noreferrer">All firmware</a>
      </div>
    </div>
    <div class:list={[card, reveal]}>
      <CwIcon name="script" class="size-9 text-orange-400 dark:text-orange-300" />
      <h2 class="mt-4 text-2xl font-bold text-neutral-800 dark:text-neutral-200">Record and plot</h2>
      <p class="mt-3 grow text-pretty text-neutral-600 dark:text-neutral-400">
        <code>import_data.py</code> saves a detector's USB output to a file with your computer's time stamp on every event (needs <code>pyserial</code>). <code>plot.py</code> makes the pulse-height plot from a data file (needs <code>matplotlib</code>).
      </p>
      <div class="mt-6 flex flex-wrap items-center gap-4">
        <a class={btn} href={downloads.importData} target="_blank" rel="noopener noreferrer">import_data.py</a>
        <a class={link} href={downloads.plot} target="_blank" rel="noopener noreferrer">plot.py</a>
      </div>
    </div>
  </section>
</MainLayout>

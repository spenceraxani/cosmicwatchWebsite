---
import { reveal, revealImage, delay } from '@utils/motion';
import { Image } from 'astro:assets';
import MainLayout from '@/layouts/MainLayout.astro';
import { team, collaborators, sponsors, type Person } from '@data/people';
import { getCopy } from '@/copy';
import type { MarketingLocale } from '@utils/locale';

interface Props {
  locale: MarketingLocale;
}

const { locale } = Astro.props;
const copy = getCopy(locale).people;

const initials = (name: string) =>
  name
    .split(' ')
    .filter(w => /^[A-Z]/.test(w) && !w.endsWith('.'))
    .map(w => w[0])
    .slice(0, 2)
    .join('');

const groups: { title: string; people: Person[] }[] = [
  { title: copy.teamTitle, people: team },
  { title: copy.foundersTitle, people: collaborators },
];
---

<MainLayout
  title={copy.title}
  description={copy.metaDescription}
  ogTitle={copy.ogTitle}
>
  <section class="mx-auto max-w-[85rem] px-4 pt-14 pb-6 sm:px-6 lg:px-8 2xl:max-w-full">
    <h1 class:list={['text-4xl font-extrabold tracking-tight text-neutral-800 md:text-5xl dark:text-neutral-200', reveal]}>
      {copy.heading}
    </h1>
    <p class="mt-4 max-w-2xl text-lg text-pretty text-neutral-600 dark:text-neutral-400">
      {copy.subTitle}
    </p>
  </section>

  {groups.map(group => (
    <section class="mx-auto max-w-[85rem] px-4 py-8 sm:px-6 lg:px-8 2xl:max-w-full">
      <h2 class:list={['text-2xl font-bold text-neutral-800 dark:text-neutral-200', reveal]}>{group.title}</h2>
      <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {group.people.map(p => (
          <article class:list={['flex gap-4 rounded-xl bg-neutral-100 p-5 dark:bg-white/[.075]', reveal]}>
            {p.photo ? (
              <Image src={p.photo} alt={p.name} width={160} class="size-16 shrink-0 rounded-full object-cover" />
            ) : (
              <span class="flex size-16 shrink-0 items-center justify-center rounded-full bg-yellow-400 text-lg font-bold text-neutral-800" aria-hidden="true">
                {initials(p.name)}
              </span>
            )}
            <div>
              <h3 class="font-bold text-neutral-800 dark:text-neutral-200">{p.name}</h3>
              <p class="text-sm text-neutral-600 dark:text-neutral-400">{p.role}</p>
              {p.note && <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">{p.note}</p>}
              {p.email && (
                <a class="mt-2 inline-block text-sm font-medium underline underline-offset-2 text-neutral-700 dark:text-neutral-300" href={`mailto:${p.email}`}>
                  {p.email}
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>
  ))}

  <section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full">
    <h2 class:list={['text-2xl font-bold text-neutral-800 dark:text-neutral-200', reveal]}>{copy.sponsorsTitle}</h2>
    <p class="mt-2 max-w-2xl text-neutral-600 dark:text-neutral-400">{copy.sponsorsSubTitle}</p>
    <ul class="mt-6 grid gap-4 sm:grid-cols-3">
      {sponsors.map(s => (
        <li class="rounded-xl border border-neutral-300 p-5 dark:border-neutral-700">
          <p class="font-bold text-neutral-800 dark:text-neutral-200">{s.name}</p>
          <p class="text-sm text-neutral-600 dark:text-neutral-400">{s.detail}</p>
        </li>
      ))}
    </ul>
  </section>
</MainLayout>

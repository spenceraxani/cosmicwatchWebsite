---
import MainLayout from '@/layouts/MainLayout.astro';
import HeroSectionAlt from '@components/sections/landing/HeroSectionAlt.astro';
import HeroBackdrop from '@components/sections/landing/HeroBackdrop.astro';
import HeroPhoto from '@components/sections/landing/HeroPhoto.astro';
import { heroPhoto } from '@data/heroPhotos';
import FeaturesGeneral from '@components/sections/features/FeaturesGeneral.astro';
import FeaturesNavs from '@components/sections/features/FeaturesNavs.astro';
import MeasurementsSection from '@components/sections/cosmicwatch/MeasurementsSection.astro';
import MuonPipeline from '@components/sections/cosmicwatch/MuonPipeline.astro';
import AboutBrief from '@components/sections/cosmicwatch/AboutBrief.astro';
import heroImage from '@images/cw/detector-array.jpg';
import featureImage from '@images/cw/exploded-labeled-cutout.png';
import pcbImage from '@images/cw/render-main-pcb.png';
import guiImage from '@images/cw/gui-screenshot.jpg';
import pairImage from '@images/cw/photo-coincidence.jpg';
import { featuredMeasurements } from '@data/measurements';
import { REPO_URL } from '@data/navigation';
import { getCopy } from '@/copy';
import { localePath, type MarketingLocale } from '@utils/locale';
import { TOGGLES_ON } from '@utils/designToggles';

interface Props {
  locale: MarketingLocale;
}

const { locale } = Astro.props;
const t = getCopy(locale);
const copy = t.home;

// On the dev server both heroes are on the page and the bottom-left switch
// (DesignToggles) picks one. A build ships the photo hero only.
const toggles = TOGGLES_ON;
const heroProps = {
  eyebrow: copy.hero.eyebrow,
  title: copy.hero.title,
  subTitle: copy.hero.subTitle,
  primaryBtn: copy.hero.primaryBtn,
  primaryBtnURL: localePath(
    locale,
    '/docs/guides/instruction-manual/how-to-build-a-cosmicwatch-detector-v3x/'
  ),
  secondaryBtn: copy.hero.secondaryBtn,
  secondaryBtnURL: localePath(locale, '/shop'),
};
---

<MainLayout designToggles="all">
  {toggles ? (
    <>
      <div data-hero-variant="photo" class="contents">
        <HeroPhoto photo={heroPhoto} {...heroProps} />
      </div>
      <div data-hero-variant="original" class="contents">
        <HeroBackdrop
          variant="tracks"
          {...heroProps}
          src={heroImage}
          alt={copy.hero.imageAlt}
        />
      </div>
    </>
  ) : (
    <HeroPhoto photo={heroPhoto} {...heroProps} />
  )}

  <AboutBrief
    title={t.about.title}
    body={t.about.body}
    peopleCta={t.about.peopleCta}
    peopleUrl={localePath(locale, '/contact')}
  />

  <FeaturesGeneral
    title={copy.featuresGeneral.title}
    subTitle={copy.featuresGeneral.subTitle}
    src={featureImage}
    alt={copy.featuresGeneral.imageAlt}
    features={t.data.features}
  />

  <MuonPipeline title={copy.pipeline.title} steps={copy.pipeline.steps} />

  <FeaturesNavs
    title={copy.featuresNavs.title}
    tabs={[
      {
        ...copy.featuresNavs.tabs.sd,
        svg: 'dashboard',
        src: pcbImage,
        first: true,
        second: true,
      },
      {
        ...copy.featuresNavs.tabs.gui,
        svg: 'frame',
        src: guiImage,
        second: true,
      },
      {
        ...copy.featuresNavs.tabs.coincidence,
        svg: 'groups',
        src: pairImage,
        second: true,
      },
    ]}
  />

  <MeasurementsSection
    title={copy.measurements.title}
    subTitle={copy.measurements.subTitle}
    measurements={featuredMeasurements}
    allTitle={copy.measurements.all}
    allUrl="/docs/guides/example-measurements/tested-measurements/"
  />

  <HeroSectionAlt
    title={copy.heroAlt.title}
    subTitle={copy.heroAlt.subTitle}
    url={REPO_URL}
  />
</MainLayout>

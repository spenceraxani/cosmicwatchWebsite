---
import { reveal, revealImage, delay } from '@utils/motion';
import MainLayout from '@/layouts/MainLayout.astro';
import MainSection from '@components/ui/blocks/MainSection.astro';
import AlternatingSections, {
  type Article,
} from '@components/ui/blocks/AlternatingSections.astro';
import glow from '@images/cw/scintillator-glow.jpg';
import southPole from '@images/cw/m-southpole.jpg';
import array from '@images/cw/detector-array.jpg';
import pair from '@images/cw/photo-coincidence.jpg';
import shower from '@images/cw/shower-diagram.jpg';
import { papers } from '@data/papers';
import { getCopy } from '@/copy';
import { localePath, type MarketingLocale } from '@utils/locale';

interface Props {
  locale: MarketingLocale;
}

const { locale } = Astro.props;
const copy = getCopy(locale).about;
const ch = copy.chapters;

const articles: Article[] = [
  {
    title: ch.origin.title,
    subTitle: ch.origin.subTitle,
    images: [{ src: glow, alt: ch.origin.imageAlts[0] }],
  },
  {
    title: ch.v2.title,
    subTitle: ch.v2.subTitle,
    images: [{ src: southPole, alt: ch.v2.imageAlts[0] }],
  },
  {
    title: ch.ud.title,
    subTitle: ch.ud.subTitle,
    images: [
      { src: array, alt: ch.ud.imageAlts[0] },
      { src: pair, alt: ch.ud.imageAlts[1] },
    ],
  },
  {
    title: ch.next.title,
    subTitle: ch.next.subTitle,
    // TODO: replace with a screenshot of the live rate map once it exists.
    images: [{ src: shower, alt: ch.next.imageAlts[0] }],
  },
];
---

<MainLayout
  title={copy.title}
  description={copy.metaDescription}
  ogTitle={copy.ogTitle}
>
  <MainSection
    title={copy.intro.title}
    subTitle={copy.intro.subTitle}
    cta={{ title: copy.intro.cta, url: localePath(locale, '/people') }}
  />

  <AlternatingSections articles={articles} />

  <section
    id="papers"
    class="mx-auto max-w-[85rem] scroll-mt-24 px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full"
  >
    <h2 class:list={['text-2xl font-bold text-neutral-800 md:text-4xl dark:text-neutral-200', reveal]}>
      {copy.papersTitle}
    </h2>
    <p class="mt-2 max-w-2xl text-pretty text-neutral-600 dark:text-neutral-400">
      {copy.papersSubTitle}
    </p>
    <ol class="mt-8 divide-y divide-neutral-300 border-y border-neutral-300 dark:divide-neutral-700 dark:border-neutral-700">
      {papers.map(p => (
        <li class="grid gap-2 py-5 sm:grid-cols-[5rem_1fr]">
          <span class="font-bold text-neutral-500 dark:text-neutral-400">
            {p.year}
          </span>
          <div>
            <a
              href={p.url}
              target="_blank"
              rel="noopener noreferrer"
              class="font-bold text-neutral-800 underline-offset-2 hover:underline dark:text-neutral-200"
            >
              {p.title}
            </a>
            <p class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">
              {p.authors}. <em>{p.venue}</em>
              {p.arxiv && (
                <>
                  {'. '}
                  <a
                    class="underline underline-offset-2 hover:text-neutral-800 dark:hover:text-neutral-200"
                    href={`https://arxiv.org/abs/${p.arxiv}`}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    arXiv:{p.arxiv}
                  </a>
                </>
              )}
            </p>
          </div>
        </li>
      ))}
    </ol>
  </section>
</MainLayout>

---
import { reveal, revealImage, delay } from '@utils/motion';
import IconBlock from '@components/ui/blocks/IconBlock.astro';
import CwIcon from '@components/ui/icons/CwIcon.astro';

interface Step {
  title: string;
  body: string;
}
interface Props {
  title: string;
  subTitle?: string;
  steps: Step[];
}
const { title, subTitle, steps } = Astro.props;
const icons = ['muon', 'scintillator', 'sipm', 'pulse', 'datafile'] as const;
---

<section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full">
  <div class:list={['mb-10 max-w-3xl', reveal]}>
    <h2 class="text-2xl font-bold text-balance text-neutral-800 md:text-4xl md:leading-tight dark:text-neutral-200">
      {title}
    </h2>
    {subTitle && (
      <p class="mt-1 text-pretty text-neutral-600 dark:text-neutral-400">
        {subTitle}
      </p>
    )}
  </div>
  <ol class="grid gap-8 sm:grid-cols-2 md:gap-12 lg:grid-cols-3">
    {steps.map((step, i) => (
      <li class:list={[reveal, delay((i % 3) + 1)]}>
        <IconBlock heading={`${i + 1}. ${step.title}`} content={step.body}>
          <CwIcon
            name={icons[i] ?? 'muon'}
            class="mt-1 h-8 w-8 shrink-0 text-orange-400 dark:text-orange-300"
          />
        </IconBlock>
      </li>
    ))}
  </ol>
</section>

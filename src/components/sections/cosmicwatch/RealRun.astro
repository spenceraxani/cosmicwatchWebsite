---
import { reveal, revealImage, delay } from '@utils/motion';
import PrimaryCTA from '@components/ui/buttons/PrimaryCTA.astro';
import run from '@data/real-run.json';

// Drawn at build time, no client JavaScript.
interface Props {
  title: string;
  body: string;
  pressureLabel: string;
  rateLabel: string;
  timeLabel: string;
  finding: string;
  findingNote: string;
  cta: string;
  ctaUrl: string;
  source: string;
}
const { title, body, pressureLabel, rateLabel, timeLabel, finding, findingNote, cta, ctaUrl, source } = Astro.props;

const hours = run.hours;
const W = 760;
const H = 150;
const PAD = { l: 52, r: 12, t: 10, b: 8 };
const x = (h: number) => PAD.l + (h / (hours.length - 1)) * (W - PAD.l - PAD.r);

function series(values: number[]) {
  const lo = Math.min(...values);
  const hi = Math.max(...values);
  const span = hi - lo || 1;
  const y = (v: number) => PAD.t + (1 - (v - lo) / span) * (H - PAD.t - PAD.b);
  const d = values.map((v, i) => `${i ? 'L' : 'M'}${x(i).toFixed(1)} ${y(v).toFixed(1)}`).join('');
  return { d, lo, hi, y };
}

const pressure = series(hours.map(h => h.pressureHPa));
const perMin = hours.map(h => h.coincRate * 60); // per minute reads better
const rate = series(perMin);
// 5-hour running average drawn over the hourly points, on the same scale
const smooth = perMin.map((_, i) => {
  const w = perMin.slice(Math.max(0, i - 2), i + 3);
  return w.reduce((a, b) => a + b, 0) / w.length;
});
const smoothD = smooth.map((v, i) => `${i ? 'L' : 'M'}${x(i).toFixed(1)} ${rate.y(v).toFixed(1)}`).join('');
const ticks = [0, 12, 24, 36, 48, 60].filter(t => t < hours.length);
const fmt = (n: number, d = 0) => n.toFixed(d);
---

<section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full">
  <div class="grid gap-10 lg:grid-cols-[1fr_1.6fr] lg:items-start lg:gap-14">
    <div class={reveal}>
      <h2 class="text-2xl font-bold text-balance text-neutral-800 md:text-4xl md:leading-tight dark:text-neutral-200">{title}</h2>
      <p class="mt-3 text-pretty text-neutral-600 dark:text-neutral-400">{body}</p>
      <p class="mt-8 text-2xl font-bold text-orange-400 tabular-nums dark:text-orange-300">{finding}</p>
      <p class="mt-1 text-sm text-pretty text-neutral-600 dark:text-neutral-400">{findingNote}</p>
      <div class="mt-8">
        <PrimaryCTA title={cta} url={ctaUrl} />
      </div>
    </div>

    <figure class:list={['surface p-5 sm:p-6', [revealImage, delay(1)]]}>
      <svg viewBox={`0 0 ${W} ${H * 2 + 70}`} class="w-full" role="img" aria-label={`${pressureLabel} and ${rateLabel} over ${run.durationHours} hours, hourly.`}>
        <g class="text-neutral-500 dark:text-neutral-400" fill="currentColor" font-size="12" font-family="var(--font-sans)">
          <text x={PAD.l} y="12">{pressureLabel}</text>
          <text x={PAD.l} y={H + 42}>{rateLabel}</text>
        </g>

        <g transform="translate(0 18)">
          {[pressure.lo, pressure.hi].map(v => (
            <g>
              <line x1={PAD.l} x2={W - PAD.r} y1={pressure.y(v)} y2={pressure.y(v)} class="stroke-neutral-300 dark:stroke-neutral-700" />
              <text x={PAD.l - 8} y={pressure.y(v) + 4} text-anchor="end" font-size="11" class="fill-neutral-500 dark:fill-neutral-400">{fmt(v)}</text>
            </g>
          ))}
          <path d={pressure.d} fill="none" stroke-width="2" class="stroke-neutral-600 dark:stroke-neutral-300" />
        </g>

        <g transform={`translate(0 ${H + 48})`}>
          {[rate.lo, rate.hi].map(v => (
            <g>
              <line x1={PAD.l} x2={W - PAD.r} y1={rate.y(v)} y2={rate.y(v)} class="stroke-neutral-300 dark:stroke-neutral-700" />
              <text x={PAD.l - 8} y={rate.y(v) + 4} text-anchor="end" font-size="11" class="fill-neutral-500 dark:fill-neutral-400">{fmt(v, 1)}</text>
            </g>
          ))}
          <path d={rate.d} fill="none" stroke-width="1" class="stroke-orange-200 dark:stroke-neutral-600" />
          <path d={smoothD} fill="none" stroke-width="2.5" class="stroke-orange-400 dark:stroke-yellow-400" />
          {ticks.map(t => (
            <text x={x(t)} y={H + 14} text-anchor="middle" font-size="11" class="fill-neutral-500 dark:fill-neutral-400">{t} h</text>
          ))}
        </g>
      </svg>
      <figcaption class="mt-3 text-sm text-pretty text-neutral-500 dark:text-neutral-400">
        {timeLabel} {source}
      </figcaption>
    </figure>
  </div>
</section>

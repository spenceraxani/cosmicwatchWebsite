---
// Short "about" on the home page. Kept deliberately brief so it never needs updating.
import { reveal } from '@utils/motion';
import PrimaryCTA from '@components/ui/buttons/PrimaryCTA.astro';

interface Props {
  title: string;
  body: string;
  peopleCta: string;
  peopleUrl: string;
}

const { title, body, peopleCta, peopleUrl } = Astro.props;
---

<section
  id="about"
  class="mx-auto max-w-5xl scroll-mt-28 px-4 py-16 text-center sm:px-6 lg:px-8 lg:py-24"
>
  <div class={reveal}>
    <h2 class="text-2xl font-bold text-balance text-neutral-800 md:text-4xl md:leading-tight dark:text-neutral-200">
      {title}
    </h2>
    <p class="mt-5 text-lg leading-relaxed text-pretty text-neutral-700 lg:text-xl lg:leading-relaxed dark:text-neutral-400">
      {body}
    </p>
    <div class="mt-6">
      <PrimaryCTA title={peopleCta} url={peopleUrl} />
    </div>
  </div>
</section>

---
import { reveal, revealImage, delay } from '@utils/motion';
import AccordionItem from '@components/ui/blocks/AccordionItem.astro';
import { Image } from 'astro:assets';
import stack from '@images/cw/detector-stack-cutout.png';
import type { CwIconName } from '@components/ui/icons/CwIcon.astro';
import { CONTACT_EMAIL } from '@data/navigation';

const { title, faqs } = Astro.props;

interface Faq {
  question: string;
  answer: string;
  icon?: string;
}

interface FaqGroup {
  subTitle?: string;
  faqs: Faq[];
}

interface Props {
  title: string;
  faqs: FaqGroup;
}
const makeId = (base: any, index: any) => `${base}${index + 1}`;
---

<section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full">
  <div class="grid gap-10 md:grid-cols-5">
    <div class="md:col-span-2">
      <div class:list={['max-w-xs', reveal]}>
        <h2 class="text-2xl font-bold text-neutral-800 md:text-4xl md:leading-tight dark:text-neutral-200">
          <Fragment set:html={title} />
        </h2>
        <p class="mt-1 text-neutral-600 dark:text-neutral-400">
          {faqs.subTitle}
        </p>
        {/* The "still stuck" line leads straight to the form or an email. */}
        <div class="mt-4 flex flex-wrap gap-3">
          <a
            href="/contact#contact-form"
            data-focus-form
            class="inline-flex items-center justify-center rounded-lg bg-orange-400 px-4 py-2.5 text-sm font-bold text-neutral-50 ring-zinc-500 outline-hidden transition duration-300 hover:bg-orange-500 focus-visible:ring-3 dark:bg-orange-300 dark:text-neutral-900 dark:ring-zinc-200 dark:hover:bg-orange-400"
          >
            Send a Message
          </a>
          <a
            href={`mailto:${CONTACT_EMAIL}`}
            class="inline-flex items-center justify-center rounded-lg border border-neutral-300 bg-neutral-50 px-4 py-2.5 text-sm font-bold text-neutral-700 ring-zinc-500 outline-hidden transition duration-300 hover:bg-neutral-100 focus-visible:ring-3 dark:border-neutral-600 dark:bg-neutral-800 dark:text-neutral-200 dark:ring-zinc-200 dark:hover:bg-neutral-700"
          >
            Email Us
          </a>
        </div>
      </div>
      {/* Small illustration: the detectors on a soft disc, with question badges */}
      <div
        aria-hidden="true"
        class:list={['relative mt-10 hidden size-64 md:block', revealImage]}
      >
        <div class="absolute inset-4 rounded-full bg-gradient-to-br from-orange-400/15 to-yellow-400/10"></div>
        <div class="absolute inset-10 rounded-full border border-dashed border-orange-400/30"></div>
        <Image
          src={stack}
          alt=""
          width={360}
          class="absolute inset-0 m-auto w-36 drop-shadow-[0_18px_24px_rgba(13,26,39,0.25)]"
        />
        <span class="cw-faq-bubble absolute top-6 right-6 flex size-10 items-center justify-center rounded-full bg-white text-lg font-bold text-orange-400 shadow-md">
          ?
        </span>
        <span
          class="cw-faq-bubble absolute bottom-10 left-3 flex size-8 items-center justify-center rounded-full bg-orange-400 text-sm font-bold text-white shadow-md"
          style="animation-delay:1.5s"
        >
          ?
        </span>
      </div>
    </div>
    <div class="md:col-span-3">
      <div
        class:list={[
          'hs-accordion-group divide-y divide-neutral-200 dark:divide-neutral-700',
          [reveal, delay(1)],
        ]}
      >
        {faqs.faqs.map((question, i) => {
          {
            /* Generate ids dynamically for each FAQ accordion item. */
          }
          let id = makeId(
            'hs-basic-with-title-and-arrow-stretched-heading-',
            i
          );
          let collapseId = makeId(
            'hs-basic-with-title-and-arrow-stretched-collapse',
            i
          );

          return (
            <AccordionItem
              {...question}
              id={id}
              collapseId={collapseId}
              first={i === 0}
              icon={question.icon as CwIconName | undefined}
            />
          );
        })}
      </div>
    </div>
  </div>
</section>

<script>
  // On the Contact page, "Send a Message" scrolls up to the form and puts the
  // cursor in its first field.
  for (const a of document.querySelectorAll<HTMLAnchorElement>(
    'a[data-focus-form]'
  )) {
    a.addEventListener('click', e => {
      const form = document.getElementById('contact-form');
      if (!form) return;
      e.preventDefault();
      form.scrollIntoView({ behavior: 'smooth', block: 'center' });
      form.querySelector<HTMLInputElement>('input, textarea')?.focus({
        preventScroll: true,
      });
      history.replaceState(null, '', '#contact-form');
    });
  }
</script>

<style>
  .cw-faq-bubble {
    animation: cw-faq-bob 5s ease-in-out infinite;
  }
  @keyframes cw-faq-bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-5px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cw-faq-bubble {
      animation: none;
    }
  }
</style>

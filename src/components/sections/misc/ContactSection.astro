---
import { reveal, revealImage, delay } from '@utils/motion';
import ContactIconBlock from '@components/ui/blocks/ContactIconBlock.astro';
import TextInput from '@components/ui/forms/input/TextInput.astro';
import EmailContactInput from '@components/ui/forms/input/EmailContactInput.astro';
import TextAreaInput from '@components/ui/forms/input/TextAreaInput.astro';
import AuthBtn from '@components/ui/buttons/AuthBtn.astro';
import CwIcon from '@components/ui/icons/CwIcon.astro';
import {
  CONTACT_EMAIL,
  CONTACT_ENDPOINT,
  TURNSTILE_SITE_KEY,
  CONTACT_FDP_FORM_ID,
  FDP_ACTION,
} from '@data/navigation';

// How the form sends (see src/data_files/navigation.ts):
// - 'service': the contact Worker (workers/contact/) checks Cloudflare
//   Turnstile and other spam signals, then emails Prof. Axani; the page posts
//   in the background, then shows /contact/thanks/.
// - 'fdp': UD's Forms Data Processor; the browser posts and FDP redirects.
// - 'email': nothing set up yet; Send opens the visitor's email app with the
//   message already written.
const copy = Astro.locals.copy.contact;
const mode =
  CONTACT_ENDPOINT && TURNSTILE_SITE_KEY
    ? 'service'
    : CONTACT_FDP_FORM_ID
      ? 'fdp'
      : 'email';
const live = mode === 'fdp';
const blockIconClass =
  'mt-1.5 h-6 w-6 shrink-0 text-neutral-600 dark:text-neutral-400';
---

<section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
  <div class="mx-auto max-w-2xl lg:max-w-5xl">
    <div class="text-center">
      <h1
        class:list={[
          'text-2xl font-bold tracking-tight text-balance text-neutral-800 md:text-4xl md:leading-tight dark:text-neutral-200',
          reveal,
        ]}
      >
        {copy.heading}
      </h1>
      <p class="mt-1 text-pretty text-neutral-600 dark:text-neutral-400">
        {copy.subTitle}
      </p>
    </div>

    <div class="mt-12 grid items-center gap-6 lg:grid-cols-2 lg:gap-16">
      <div class="flex flex-col rounded-xl p-4 sm:p-6 lg:p-8">
        <h2
          class:list={[
            'mb-8 text-xl font-bold text-neutral-700 dark:text-neutral-300',
            reveal,
          ]}
        >
          {copy.formTitle}
        </h2>
        <form
          id="contact-form"
          method="post"
          action={live ? FDP_ACTION : undefined}
          novalidate
          data-mode={mode}
          data-endpoint={CONTACT_ENDPOINT || undefined}
          data-to={CONTACT_EMAIL}
          data-sending={copy.sending}
          data-missing={copy.missing}
          data-captcha={copy.captcha}
        >
          {live && (
            <input type="hidden" name="formId" value={CONTACT_FDP_FORM_ID} />
          )}
          {mode === 'service' && (
            <input type="hidden" name="started" value="" />
          )}
          <div class="grid gap-4">
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <TextInput
                id="contact-first"
                label={copy.firstName}
                name="first"
              />
              <TextInput id="contact-last" label={copy.lastName} name="last" />
            </div>
            <EmailContactInput id="contact-email" name="email" />
            <TextAreaInput
              id="contact-message"
              label={copy.details}
              name="message"
            />
            {/* Spam trap: people never see or tick this; bots often do. */}
            <input
              type="checkbox"
              name="website_check"
              class="hidden"
              tabindex="-1"
              autocomplete="off"
              aria-hidden="true"
            />
          </div>
          {mode === 'service' && (
            <div
              class="cf-turnstile mt-4"
              data-sitekey={TURNSTILE_SITE_KEY}
              data-action="contact"
              data-theme="auto"
              data-size="flexible"
            ></div>
          )}
          <div class="mt-4 grid">
            <AuthBtn title={copy.send} />
          </div>
          <p
            id="contact-status"
            class="mt-3 min-h-5 text-center text-sm font-medium text-neutral-700 dark:text-neutral-300"
            role="status"
            aria-live="polite"
          ></p>
          <p
            id="contact-failed"
            class="mt-1 text-center text-sm text-red-700 dark:text-red-400"
            hidden
          >
            {copy.notLive}{' '}
            <a
              id="contact-fallback"
              class="underline underline-offset-2"
              href={`mailto:${CONTACT_EMAIL}`}
            >
              {copy.notLiveLink}
            </a>
            .
          </p>
        </form>
      </div>

      <div class="divide-y divide-neutral-300 dark:divide-neutral-700">
        <ContactIconBlock
          heading={copy.leadHeading}
          oneLine
          content={copy.leadContent}
          isLinkVisible={true}
          linkTitle={CONTACT_EMAIL}
          linkURL={`mailto:${CONTACT_EMAIL}`}
        >
          <CwIcon name="mail" class={blockIconClass} />
        </ContactIconBlock>
        <ContactIconBlock
          heading={copy.officeHeading}
          content={copy.officeContent}
          isAddressVisible={true}
          addressContent={copy.officeAddress}
        >
          <CwIcon name="pin" class={blockIconClass} />
        </ContactIconBlock>
        <ContactIconBlock
          heading={copy.docsHeading}
          content={copy.docsContent}
          isLinkVisible={true}
          linkTitle={copy.docsLink}
          linkURL="/docs/"
          isArrowVisible={true}
        >
          <CwIcon name="docs" class={blockIconClass} />
        </ContactIconBlock>
        <ContactIconBlock
          heading={copy.troubleshootHeading}
          content={copy.troubleshootContent}
          isLinkVisible={true}
          linkTitle={copy.troubleshootLink}
          linkURL="/docs/guides/troubleshooting/troubleshooting/"
          isArrowVisible={true}
        >
          <CwIcon name="wrench" class={blockIconClass} />
        </ContactIconBlock>
      </div>
    </div>
  </div>
</section>

{mode === 'service' && (
  <script
    is:inline
    src="https://challenges.cloudflare.com/turnstile/v0/api.js"
    async
    defer
  ></script>
)}
<script>
  // Checks the fields, then sends the message the way data-mode says.
  const form = document.getElementById(
    'contact-form'
  ) as HTMLFormElement | null;
  if (form) {
    const status = document.getElementById('contact-status')!;
    const failed = document.getElementById('contact-failed')!;
    const fallback = document.getElementById(
      'contact-fallback'
    ) as HTMLAnchorElement;
    const button = form.querySelector(
      'button[type="submit"]'
    ) as HTMLButtonElement;
    const {
      to,
      sending,
      missing,
      mode,
      endpoint,
      captcha: captchaMsg,
    } = form.dataset;
    const started = form.elements.namedItem(
      'started'
    ) as HTMLInputElement | null;
    if (started) started.value = String(Date.now());
    form.addEventListener('submit', async e => {
      failed.hidden = true;
      const data = new FormData(form);
      const get = (k: string) => String(data.get(k) ?? '').trim();
      const name = `${get('first')} ${get('last')}`.trim();
      const email = get('email');
      const message = get('message');
      const emailOk = (
        form.elements.namedItem('email') as HTMLInputElement
      ).checkValidity();
      if (!message || !email || !emailOk) {
        e.preventDefault();
        status.textContent = missing!;
        return;
      }
      if (data.get('website_check') !== null) {
        e.preventDefault(); // spam trap ticked: a bot, not a person
        return;
      }
      const subject = `CosmicWatch question${name ? ` from ${name}` : ''}`;
      const body = `${message}\n\n${name}${email ? ` <${email}>` : ''}`;
      fallback.href = `mailto:${to}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

      if (mode === 'fdp') {
        status.textContent = sending!;
        button.disabled = true;
        return; // let the browser post the form to FDP
      }
      e.preventDefault();
      if (mode === 'email') {
        // No form service yet: hand the message to the visitor's email app.
        status.textContent = '';
        failed.hidden = false;
        window.location.href = fallback.href;
        return;
      }
      if (!String(data.get('cf-turnstile-response') ?? '')) {
        status.textContent = captchaMsg!; // the check has not finished yet
        return;
      }
      status.textContent = sending!;
      button.disabled = true;
      try {
        const r = await fetch(endpoint!, {
          method: 'POST',
          body: data,
          headers: { Accept: 'application/json' },
        });
        const res = await r.json().catch(() => ({}));
        if (!r.ok || !res.ok) throw new Error(res.error || String(r.status));
        window.location.href = '/contact/thanks/';
      } catch (err) {
        status.textContent = String(err).includes('captcha') ? captchaMsg! : '';
        failed.hidden = false;
        button.disabled = false;
        (
          window as Window & { turnstile?: { reset(): void } }
        ).turnstile?.reset();
      }
    });
  }
</script>

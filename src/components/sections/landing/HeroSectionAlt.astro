---
// "Everything is open source" closer on the home page. Open-source icons are
// scattered across the whole section, each tilted at its own angle, behind the
// heading. They don't move; the middle stays clear for the text. Shown on wide
// screens only: on phones and tablets there is no room around the text.
import { reveal, delay } from '@utils/motion';
import GithubBtn from '@components/ui/buttons/GithubBtn.astro';

const { title, subTitle, url } = Astro.props;

const btnTitle = Astro.locals.copy.home.heroAlt.btn;

interface Props {
  title: string;
  subTitle?: string;
  url?: string;
}

// Lucide-style 24×24 stroke icons (ISC licence), plus the GitHub mark.
const ICONS: Record<string, string> = {
  github:
    '<path fill="currentColor" stroke="none" d="M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.08-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.82 1.19 3.08 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"/>',
  code: '<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>',
  branch:
    '<line x1="6" x2="6" y1="3" y2="15"/><circle cx="18" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M18 9a9 9 0 0 1-9 9"/>',
  fork: '<circle cx="12" cy="18" r="3"/><circle cx="6" cy="6" r="3"/><circle cx="18" cy="6" r="3"/><path d="M18 9v2c0 .6-.4 1-1 1H7c-.6 0-1-.4-1-1V9"/><path d="M12 12v3"/>',
  pull: '<circle cx="18" cy="18" r="3"/><circle cx="6" cy="6" r="3"/><path d="M13 6h3a2 2 0 0 1 2 2v7"/><line x1="6" x2="6" y1="9" y2="21"/>',
  commit:
    '<circle cx="12" cy="12" r="3"/><line x1="3" x2="9" y1="12" y2="12"/><line x1="15" x2="21" y1="12" y2="12"/>',
  terminal:
    '<polyline points="4 17 10 11 4 5"/><line x1="12" x2="20" y1="19" y2="19"/>',
  chip: '<rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><path d="M15 2v2M15 20v2M2 15h2M2 9h2M20 15h2M20 9h2M9 2v2M9 20v2"/>',
  file: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="m10 13-2 2 2 2"/><path d="m14 17 2-2-2-2"/>',
  license:
    '<path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="M7 21h10"/><path d="M12 3v18"/><path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/>',
  people:
    '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  heart:
    '<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>',
  book: '<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>',
  wrench:
    '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>',
  download:
    '<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/>',
  globe:
    '<circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/>',
};

// Fixed seed, so the layout is identical on every load.
let seed = 11;
const rand = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
const names = Object.keys(ICONS);
const scatter: {
  name: string;
  left: number;
  top: number;
  size: number;
  tilt: number;
  fade: number;
}[] = [];
// Place on a loose grid with jitter so icons cover the section evenly-ish,
// skipping the cells behind the heading and button.
const cols = 8,
  rows = 4;
let k = 0;
for (let r = 0; r < rows; r++) {
  for (let c = 0; c < cols; c++) {
    const left = ((c + 0.2 + rand() * 0.6) / cols) * 100;
    const top = ((r + 0.15 + rand() * 0.7) / rows) * 100;
    if (left > 27 && left < 73 && top > 18 && top < 84) continue; // keep the text clear
    scatter.push({
      name: names[k++ % names.length],
      left,
      top,
      size: 26 + Math.round(rand() * 22),
      tilt: Math.round((rand() - 0.5) * 70),
      fade: 0.22 + rand() * 0.3,
    });
  }
}
---

<section class="relative isolate mx-auto max-w-[85rem] overflow-hidden px-4 py-24 sm:px-6 lg:px-8 lg:py-32">
  <ul
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10 hidden lg:block"
  >
    {scatter.map((o, i) => (
      <li
        class="absolute -translate-x-1/2 -translate-y-1/2 text-orange-400"
        style={`left:${o.left.toFixed(2)}%;top:${o.top.toFixed(2)}%;width:${o.size}px;height:${o.size}px;opacity:${o.fade.toFixed(2)}`}
      >
        <div class:list={['size-full', reveal, delay(i % 5)]}>
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="size-full"
            style={`transform:rotate(${o.tilt}deg)`}
            set:html={ICONS[o.name]}
          />
        </div>
      </li>
    ))}
  </ul>

  <div class:list={['mx-auto max-w-4xl text-center', reveal]}>
    <h2 class="block text-4xl leading-tight font-bold tracking-tight text-balance text-neutral-800 md:text-5xl lg:text-6xl dark:text-neutral-200">
      <Fragment set:html={title} />
    </h2>
  </div>
  <div class:list={['mx-auto mt-5 max-w-xl text-center', [reveal, delay(1)]]}>
    {subTitle && (
      <p class="text-lg text-pretty text-neutral-600 dark:text-neutral-400">
        {subTitle}
      </p>
    )}
  </div>
  {url && (
    <div class="mt-8 flex justify-center gap-3">
      <GithubBtn url={url} title={btnTitle} />
    </div>
  )}
</section>

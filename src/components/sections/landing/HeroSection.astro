---
import { reveal, revealImage, delay } from '@utils/motion';
import { Image } from 'astro:assets';
import PrimaryCTA from '@components/ui/buttons/PrimaryCTA.astro';
import SecondaryCTA from '@components/ui/buttons/SecondaryCTA.astro';
import ReviewComponent from '@components/ui/blocks/ReviewComponent.astro';

const {
  title,
  subTitle,
  primaryBtn,
  primaryBtnURL,
  secondaryBtn,
  secondaryBtnURL,
  withReview,
  avatars,
  starCount,
  rating,
  reviews,
  src,
  alt,
  fit = 'cover',
} = Astro.props;

interface Props {
  title: string;
  subTitle?: string;
  primaryBtn?: string;
  primaryBtnURL?: string;
  secondaryBtn?: string;
  secondaryBtnURL?: string;
  withReview?: boolean;
  avatars?: Array<string>;
  starCount?: number;
  rating?: string;
  reviews?: string;
  src?: any;
  alt?: string;
  /** `cover` crops to the template's hero ratio; `contain` shows the whole image. */
  fit?: 'cover' | 'contain';
}
---

<section class="mx-auto grid max-w-[85rem] gap-4 px-4 py-14 sm:px-6 md:grid-cols-2 md:items-center md:gap-8 lg:px-8 2xl:max-w-full">
  <div>
    <h1 class:list={['block text-3xl font-bold tracking-tight text-balance text-neutral-800 sm:text-4xl lg:text-6xl lg:leading-tight dark:text-neutral-200', reveal]}>
      <Fragment set:html={title} />
    </h1>
    {subTitle && (
      <p class:list={['mt-3 text-lg leading-relaxed text-pretty text-neutral-700 lg:w-4/5 dark:text-neutral-400', [reveal, delay(1)]]}>
        {subTitle}
      </p>
    )}
    <div class:list={['mt-7 grid w-full gap-3 sm:inline-flex', [reveal, delay(2)]]}>
      {primaryBtn && <PrimaryCTA title={primaryBtn} url={primaryBtnURL} />}
      {secondaryBtn && (
        <SecondaryCTA title={secondaryBtn} url={secondaryBtnURL} />
      )}
    </div>

    {withReview ? (
      <ReviewComponent
        avatars={avatars}
        starCount={starCount}
        rating={rating}
        reviews={reviews}
      />
    ) : (
      ''
    )}
  </div>
  <div class:list={['flex w-full', [revealImage, delay(1)]]}>
    <div class:list={['w-full overflow-hidden', fit === 'cover' ? 'aspect-[4067/2576]' : 'rounded-xl']}>
      {src && alt && (
        <Image
          src={src}
          alt={alt}
          class:list={['h-full w-full object-center', fit === 'cover' ? 'scale-110 object-cover' : 'object-contain']}
          draggable={'false'}
          loading="eager"
          fetchpriority="high"
          width={1100}
          format={'avif'}
        />
      )}
    </div>
  </div>
</section>

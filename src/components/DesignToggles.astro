---
// Bottom-left panel for switching between hero and nav designs (dev only, see
// src/utils/designToggles.ts). The choice is saved, so it carries across pages.
import { HERO_CHOICES, NAV_CHOICES } from '@utils/designToggles';

interface Props {
  /** Show the hero switch (only the home page has the hero). */
  hero?: boolean;
}
const { hero = false } = Astro.props;

const groups = [
  ...(hero ? [{ key: 'hero', label: 'Hero', choices: HERO_CHOICES }] : []),
  { key: 'nav', label: 'Nav', choices: NAV_CHOICES },
];
---

<div class="cw-design-toggles" role="group" aria-label="Design versions">
  {groups.map(g => (
    <div class="cw-dt-row">
      <span class="cw-dt-label">{g.label}</span>
      {g.choices.map(c => (
        <button type="button" data-toggle-key={g.key} data-toggle-value={c.id}>
          {c.label}
        </button>
      ))}
    </div>
  ))}
</div>

<script>
  // The docs header has a backdrop blur, which would pin a fixed panel inside it
  // (top-left, over the logo). Moving the panel to <body> keeps it bottom-left.
  const lift = () => {
    document
      .querySelectorAll<HTMLElement>('.cw-design-toggles')
      .forEach((p, i, all) => {
        if (i < all.length - 1) p.remove();
        else if (p.parentElement !== document.body)
          document.body.appendChild(p);
      });
  };
  lift();
  document.addEventListener('astro:page-load', lift);
  document.addEventListener('astro:after-swap', lift);
  const sync = () => {
    const d = document.documentElement;
    document
      .querySelectorAll<HTMLButtonElement>('[data-toggle-key]')
      .forEach(b => {
        const on = d.dataset[b.dataset.toggleKey!] === b.dataset.toggleValue;
        b.setAttribute('aria-pressed', String(on));
      });
  };
  document.addEventListener('click', e => {
    const b = (e.target as Element).closest<HTMLButtonElement>(
      '[data-toggle-key]'
    );
    if (!b) return;
    const key = b.dataset.toggleKey!;
    const value = b.dataset.toggleValue!;
    document.documentElement.dataset[key] = value;
    try {
      localStorage.setItem(`cw-${key}`, value);
    } catch {}
    sync();
    // The hero and header heights change, so let layout code re-measure.
    window.dispatchEvent(new Event('resize'));
  });
  sync();
  document.addEventListener('astro:page-load', sync);
</script>

<style is:global>
  /* Plain CSS (no Tailwind) so the panel looks the same on the docs pages. */
  .cw-design-toggles {
    position: fixed;
    bottom: 1rem;
    left: 1rem;
    z-index: 60;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    max-width: calc(100vw - 2rem);
    padding: 0.25rem;
    border: 1px solid #d4d4d4;
    border-radius: 0.5rem;
    background: rgb(255 255 255 / 0.95);
    box-shadow:
      0 10px 15px -3px rgb(0 0 0 / 0.1),
      0 4px 6px -4px rgb(0 0 0 / 0.1);
    backdrop-filter: blur(8px);
    font:
      600 0.75rem/1rem system-ui,
      sans-serif;
  }
  .cw-dt-row {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .cw-dt-label {
    width: 2.75rem;
    padding-inline: 0.5rem;
    color: #737373;
  }
  .cw-design-toggles button {
    margin: 0;
    padding: 0.375rem 0.625rem;
    border: 0;
    border-radius: 0.375rem;
    background: transparent;
    color: #404040;
    font: inherit;
    cursor: pointer;
  }
  .cw-design-toggles button:hover {
    background: #e5e5e5;
  }
  .cw-design-toggles button[aria-pressed='true'] {
    background: #2a618f;
    color: #fff;
  }

  /* Hero: only the chosen version is shown. */
  html:not([data-hero='original']) [data-hero-variant='original'],
  html[data-hero='original'] [data-hero-variant='photo'] {
    display: none !important;
  }

  /* Nav "Bubble": the earlier floating, rounded nav, 16px from the top. */
  html[data-nav='bubble'] #site-header {
    top: 1rem;
    padding-inline: 1rem;
    border: 0;
    background: transparent;
    box-shadow: none;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }
  html[data-nav='bubble'] #site-header > nav {
    padding-inline: 1.25rem;
    border: 1px solid rgb(255 255 255 / 0.7);
    border-radius: 36px;
    background: rgb(255 255 255 / 0.75);
    box-shadow: 0 8px 30px -12px rgb(13 26 39 / 0.25);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  @media (min-width: 40rem) {
    html[data-nav='bubble'] #site-header {
      padding-inline: 1.5rem;
    }
  }
  @media (min-width: 64rem) {
    html[data-nav='bubble'] #site-header {
      padding-inline: 2rem;
    }
    html[data-nav='bubble'] #site-header > nav {
      padding-inline: 2rem;
    }
  }
  html.dark[data-nav='bubble'] #site-header > nav {
    border-color: rgb(64 64 64 / 0.6);
    background: rgb(23 23 23 / 0.8);
  }

  /* Docs pages: the same bubble inside a transparent strip. */
  :root[data-nav='bubble'] {
    --sl-nav-height: 5.5rem !important;
  }
  html[data-nav='bubble'] header.header {
    background: transparent !important;
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
    border: none !important;
    box-shadow: none !important;
    padding: 1rem 1rem 0.5rem !important;
  }
  html[data-nav='bubble'] .cw-docs-nav {
    padding-inline: 1.25rem 4.25rem;
    border: 1px solid rgb(255 255 255 / 0.7);
    border-radius: 36px;
    background: rgb(255 255 255 / 0.75);
    box-shadow: 0 8px 30px -12px rgb(13 26 39 / 0.25);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  html[data-nav='bubble'] button.sl-menu-button {
    top: 2rem !important;
    inset-inline-end: 2rem !important;
  }
  @media (min-width: 40rem) {
    html[data-nav='bubble'] header.header {
      padding-inline: 1.5rem !important;
    }
  }
  @media (min-width: 64rem) {
    html[data-nav='bubble'] header.header {
      padding-inline: 2rem !important;
    }
    html[data-nav='bubble'] .cw-docs-nav {
      padding-inline: 2rem;
    }
  }
</style>

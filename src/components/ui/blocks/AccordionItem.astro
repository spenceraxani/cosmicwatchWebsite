---
import Icon from '@components/ui/icons/Icon.astro';
import CwIcon, { type CwIconName } from '@components/ui/icons/CwIcon.astro';
const { id, collapseId, question, answer, first, icon } = Astro.props;
interface Props {
  id: string;
  collapseId: string;
  question: string;
  answer: string;
  first?: boolean;
  icon?: CwIconName;
}
const ACCORDION_CLASS_DEFAULT = 'hs-accordion pb-3 active';
const ACCORDION_CLASS_COLLAPSED = 'hs-accordion pt-6 pb-3';
const ACCORDION_CONTENT_CLASS =
  'hs-accordion-content w-full overflow-hidden transition-[height] duration-300';
function getAccordionClass(first: boolean = false) {
  return first ? ACCORDION_CLASS_DEFAULT : ACCORDION_CLASS_COLLAPSED;
}
---

<div class={getAccordionClass(first)} id={id}>
  <button
    class="hs-accordion-toggle group inline-flex w-full items-center justify-between gap-x-3 rounded-lg pb-3 text-start font-bold text-balance text-neutral-800 ring-zinc-500 outline-hidden transition hover:text-neutral-500 focus-visible:ring-3 md:text-lg dark:text-neutral-200 dark:ring-zinc-200 dark:hover:text-neutral-400 dark:focus:outline-hidden"
    aria-expanded={first}
    aria-controls={collapseId}
  >
    <span class="flex items-center gap-x-3">
      {icon && (
        <span
          class="flex size-9 shrink-0 items-center justify-center rounded-xl bg-orange-400/10 text-orange-400"
          aria-hidden="true"
        >
          <CwIcon name={icon} class="size-5" />
        </span>
      )}
      {question}
    </span>
    <Icon
      name="chevronDown"
      class="block h-5 w-5 shrink-0 text-neutral-600 group-hover:text-neutral-500 hs-accordion-active:hidden dark:text-neutral-400"
    />

    <Icon
      name="chevronUp"
      class="hidden h-5 w-5 shrink-0 text-neutral-600 group-hover:text-neutral-500 hs-accordion-active:block dark:text-neutral-400"
    />
  </button>
  <div
    id={collapseId}
    role="region"
    aria-labelledby={id}
    class={`${first ? ACCORDION_CONTENT_CLASS : 'hidden ' + ACCORDION_CONTENT_CLASS}`}
  >
    <p
      class:list={[
        'text-pretty text-neutral-600 dark:text-neutral-400',
        icon && 'ps-12',
      ]}
    >
      {answer}
    </p>
  </div>
</div>

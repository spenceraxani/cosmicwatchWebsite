---
import Icon from '@components/ui/icons/Icon.astro';

const {
  heading,
  content,
  isAddressVisible,
  addressContent,
  isLinkVisible,
  linkTitle,
  linkURL,
  isArrowVisible,
  oneLine,
} = Astro.props;

interface Props {
  heading?: string;
  content?: string;
  isAddressVisible?: boolean;
  addressContent?: string;
  isLinkVisible?: boolean;
  linkTitle?: string;
  linkURL?: string;
  isArrowVisible?: boolean;
  /** Keep the description on one line on wide screens. */
  oneLine?: boolean;
}
---

<div class="flex gap-x-7 py-6">
  <slot />
  <div class="grow">
    <h3 class="font-bold text-neutral-700 dark:text-neutral-300">{heading}</h3>
    <p
      class:list={[
        'mt-1 text-sm text-neutral-600 dark:text-neutral-400',
        oneLine && 'xl:whitespace-nowrap',
      ]}
    >
      {content}
    </p>
    {isAddressVisible ? (
      <p class="mt-1 text-sm text-neutral-500 italic">{addressContent}</p>
    ) : null}
    {isLinkVisible ? (
      <a
        class="group mt-2 inline-flex items-center gap-x-2 rounded-lg text-sm font-medium text-zinc-600 ring-zinc-500 outline-hidden transition duration-300 hover:text-zinc-800 focus-visible:ring-3 dark:text-zinc-400 dark:ring-zinc-200 dark:hover:text-zinc-200 dark:focus:ring-1 dark:focus:outline-hidden"
        href={linkURL}
      >
        {linkTitle}
        {isArrowVisible ? (
          <Icon
            name="arrowRightLong"
            class="h-4 w-4 shrink-0 transition ease-in-out group-hover:translate-x-1"
          />
        ) : null}
      </a>
    ) : null}
  </div>
</div>

---
import { Image } from 'astro:assets';

// Destructure the component properties from Astro.props
const { id, aria, src, alt, first, second, number, actions = [] } = Astro.props;

export interface TabAction {
  label: string;
  url: string;
  /** Secondary actions render as a text link. */
  secondary?: boolean;
  /** Zip the GUI folder from GitHub on click (see src/assets/scripts/guiDownload.ts). */
  guiZip?: string;
  note?: string;
}

interface Props {
  id: string;
  aria: string;
  src?: any;
  alt: string;
  first?: boolean;
  second?: boolean;
  /** Shown in a circle on the image, matching the numbered tab. */
  number?: number;
  actions?: TabAction[];
}
// Set class based on 'first' property
// If 'first' is present, show the tab content immediately
const firstClass = first ? '' : 'hidden';
// Set class based on 'second' property
// If 'second' is present, use an alternate style for the image
const secondClass = second
  ? 'aspect-video object-contain bg-neutral-300 dark:bg-neutral-600 p-3 lg:object-cover lg:aspect-[4/3] rounded-xl'
  : 'aspect-video object-cover lg:aspect-square rounded-xl';

// Set `first` on the first panel so it is visible on load.
---

<div
  id={id}
  role="tabpanel"
  class:list={[firstClass, 'relative']}
  aria-labelledby={aria}
>
  {number && (
    <span
      aria-hidden="true"
      class="absolute top-4 left-4 z-10 flex size-11 items-center justify-center rounded-full bg-orange-400 text-xl font-bold text-white shadow-lg dark:bg-orange-300 dark:text-neutral-900"
    >
      {number}
    </span>
  )}
  <Image
    src={src}
    alt={alt}
    class={secondClass}
    draggable={'false'}
    format={'avif'}
    loading="lazy"
  />
  {actions.length > 0 && (
    <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-3">
      {actions.map(a =>
        a.secondary ? (
          <a
            href={a.url}
            class="font-medium text-orange-400 decoration-2 hover:underline dark:text-orange-300"
          >
            {a.label}
          </a>
        ) : (
          <a
            href={a.url}
            data-gui-zip={a.guiZip ? '' : undefined}
            data-repo={a.guiZip}
            class="inline-flex items-center justify-center gap-x-2 rounded-lg bg-orange-400 px-4 py-3 text-sm font-bold text-neutral-50 ring-zinc-500 outline-hidden transition duration-300 hover:bg-orange-500 focus-visible:ring-3 2xl:text-base dark:bg-orange-300 dark:text-neutral-900 dark:ring-zinc-200 dark:hover:bg-orange-400"
          >
            <span data-label>{a.label}</span>
            {a.note && (
              <span class="text-xs font-medium opacity-80">{a.note}</span>
            )}
          </a>
        )
      )}
    </div>
  )}
</div>

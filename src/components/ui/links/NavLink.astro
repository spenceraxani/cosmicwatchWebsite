---
// One link in the site's nav bar. The link for the page you are on (or a page
// under it, like /contact/thanks/ under Contact) is shown in blue, the same way
// the guides' nav bar marks it.
const { url, name } = Astro.props;

interface Props {
  url: string;
  name: string;
}

const here = Astro.url.pathname;
const current =
  url === '/' ? here === '/' : here.startsWith(url.replace(/\/?$/, '/'));
---

<a
  href={url}
  data-astro-prefetch
  aria-current={current ? 'page' : undefined}
  class:list={[
    'rounded-lg text-base font-medium ring-zinc-500 outline-hidden focus-visible:ring-3 lg:py-3 lg:text-sm 2xl:text-base dark:ring-zinc-200 dark:focus:outline-hidden',
    current
      ? 'font-semibold text-orange-400 dark:text-orange-300'
      : 'text-neutral-600 hover:text-neutral-500 dark:text-neutral-400 dark:hover:text-neutral-500',
  ]}
>
  {name}
</a>

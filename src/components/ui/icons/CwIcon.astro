---
// 24×24 grid, 1.75 stroke, round caps.
const paths = {
  // the logo's incoming arrows
  muon: '<path d="M3 6h13M3 12h16M3 18h11"/><path d="M14 3.5L16.5 6 14 8.5M17 9.5l2.5 2.5-2.5 2.5M12 15.5l2.5 2.5-2.5 2.5"/>',
  // the detector case seen from the front: screen, LEDs, reset button
  detector:
    '<rect x="2.5" y="6" width="19" height="12" rx="1.5"/><rect x="5" y="9" width="7" height="4.5" rx=".5"/><circle cx="17" cy="9.5" r="1.3"/><circle cx="17" cy="14.2" r="1.3"/><circle cx="14" cy="14.2" r=".5" fill="currentColor"/>',
  // two cases stacked for coincidence
  coincidence:
    '<rect x="3" y="3" width="18" height="7.5" rx="1.2"/><rect x="3" y="13.5" width="18" height="7.5" rx="1.2"/><path d="M6 5.5h4.5v2.5H6zM6 16h4.5v2.5H6z"/><path d="M17 6.75h.01M17 17.25h.01" stroke-width="2.5"/>',
  scintillator:
    '<path d="M3 15l5-3h13l-5 3z"/><path d="M3 15v3h13l5-3v-3"/><path d="M16 18v-3"/><path d="M12 9V5M8.5 10.5L6 8M15.5 10.5L18 8"/>',
  sipm: '<rect x="4" y="4" width="16" height="16" rx="1.5"/><rect x="8.5" y="8.5" width="7" height="7"/><path d="M10.8 8.5v7M13.2 8.5v7M8.5 10.8h7M8.5 13.2h7" stroke-width="1"/>',
  pulse:
    '<path d="M2 17h5l2-11 2.5 11H22"/><path d="M9 6h9" stroke-dasharray="2 2"/>',
  datafile:
    '<path d="M6 2.5h8l4 4V21.5H6z"/><path d="M14 2.5v4h4"/><path d="M9 11h6M9 14.5h6M9 18h3.5"/>',
  docs: '<path d="M3 5.5c3-1 6-1 9 1v13c-3-2-6-2-9-1z"/><path d="M21 5.5c-3-1-6-1-9 1v13c3-2 6-2 9-1z"/>',
  wrench:
    '<path d="M14.5 4.2a4.5 4.5 0 0 0-5.3 5.9L3.6 15.7a1.8 1.8 0 0 0 2.6 2.6l5.6-5.6a4.5 4.5 0 0 0 5.9-5.3l-2.6 2.6-2.5-.6-.6-2.5z"/>',
  pin: '<path d="M12 21s-6.5-6.2-6.5-11a6.5 6.5 0 0 1 13 0c0 4.8-6.5 11-6.5 11z"/><circle cx="12" cy="10" r="2.3"/>',
  mail: '<rect x="3" y="5.5" width="18" height="13" rx="1.5"/><path d="M3.5 6.5l8.5 6.5 8.5-6.5"/>',
  gui: '<rect x="2.5" y="4" width="19" height="16" rx="1.5"/><path d="M2.5 8h19"/><path d="M5.5 17l3-4 2.5 2 3.5-5 4 7"/>',
  usb: '<path d="M9 2.5h6v6H9z"/><path d="M7.5 8.5h9v7a4.5 4.5 0 0 1-9 0z"/><path d="M12 20v1.5M10.8 4.8h.01M13.2 4.8h.01" stroke-width="2"/>',
  firmware:
    '<rect x="6" y="2.5" width="12" height="19" rx="1"/><path d="M3.5 6h2.5M3.5 9.5h2.5M3.5 13h2.5M3.5 16.5h2.5M18 6h2.5M18 9.5h2.5M18 13h2.5M18 16.5h2.5"/><rect x="9.5" y="9" width="5" height="5"/>',
  script:
    '<rect x="2.5" y="4" width="19" height="16" rx="1.5"/><path d="M6.5 9.5l3 2.5-3 2.5M11.5 15h5"/>',
  people:
    '<circle cx="8.5" cy="8" r="3"/><path d="M3 19.5c.5-3.5 2.8-5.5 5.5-5.5s5 2 5.5 5.5"/><circle cx="16.5" cy="9" r="2.5"/><path d="M15.5 14.2c2.6-.4 4.9 1.3 5.5 4.8"/>',
  solder:
    '<path d="M14.5 3.5l6 6-3 3-6-6z"/><path d="M11.5 6.5L4 14l-1.5 6.5L9 19l7.5-7.5"/><path d="M2.5 20.5l3-3"/>',
  parts: '<path d="M4 6h16M4 12h16M4 18h10"/><circle cx="19" cy="18" r="1.6"/>',
  download:
    '<path d="M12 3.5v11M7.5 10l4.5 4.5 4.5-4.5"/><path d="M4 17v3.5h16V17"/>',
  globe:
    '<circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17M12 3.5c2.4 2.5 3.5 5.3 3.5 8.5s-1.1 6-3.5 8.5c-2.4-2.5-3.5-5.3-3.5-8.5s1.1-6 3.5-8.5z"/>',
} as const;

export type CwIconName = keyof typeof paths;

interface Props {
  name: CwIconName;
  class?: string;
  title?: string;
}

const { name, class: className = 'size-6', title } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
>
  {title && <title>{title}</title>}
  <Fragment set:html={paths[name]} />
</svg>

---
// Docs header: the same floating nav bubble as the rest of the site (logo,
// page links, GitHub, Shop), with the docs search kept on the right. On small
// screens the links move into the docs menu (MobileMenuFooter.astro).
import Search from '@astrojs/starlight/components/Search.astro';
import { navLinks, socialLinks } from '@data/navigation';
import { getCopy } from '@/copy';

const t = getCopy('en');
const here = Astro.url.pathname;
const isActive = (path: string) => (path === '/docs/' ? here.startsWith('/docs/') : here.startsWith(path));
---

<div class="cw-docs-nav">
  <a class="cw-logo" href="/" aria-label="CosmicWatch home">
    <img src="/brand/logo-darkblue.png" alt="CosmicWatch" width="1400" height="528" />
  </a>
  <nav class="cw-links" aria-label="Site">
    {navLinks.map(link => (
      <a href={link.path} aria-current={isActive(link.path) ? 'page' : undefined}>{t.nav.labels[link.id]}</a>
    ))}
    <a class="cw-icon" href={socialLinks.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
      <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true">
        <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path>
      </svg>
    </a>
    <a class="cw-shop" href="/shop">{t.nav.buy}</a>
  </nav>
  <div class="cw-search print:hidden">
    <Search />
  </div>
</div>

<style>
  .cw-docs-nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 4rem;
    max-width: 1536px;
    margin-inline: auto;
    padding-inline: 1.25rem 4.25rem; /* room on the right for the docs menu button */
    border: 1px solid rgb(255 255 255 / 0.7);
    border-radius: 36px;
    background: rgb(255 255 255 / 0.75);
    box-shadow: 0 8px 30px -12px rgb(13 26 39 / 0.25);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  .cw-logo {
    flex: none;
    display: flex;
  }
  .cw-logo img {
    height: 2rem;
    width: auto;
  }
  .cw-links {
    display: none;
    align-items: center;
    gap: 1.5rem;
    margin-inline-start: auto;
    font-size: 0.875rem;
    font-weight: 500;
  }
  .cw-links a {
    color: #4a5b6c;
    text-decoration: none;
    white-space: nowrap;
  }
  .cw-links a:hover {
    color: #6b7d8f;
  }
  .cw-links a[aria-current='page'] {
    color: #2a618f;
    font-weight: 700;
  }
  .cw-icon {
    display: inline-flex;
  }
  .cw-links a.cw-shop {
    display: inline-flex;
    align-items: center;
    border-radius: 9999px;
    background: #2a618f;
    color: #fff;
    font-weight: 600;
    padding: 0.5rem 1rem;
  }
  .cw-links a.cw-shop:hover {
    background: #22527a;
    color: #fff;
  }
  .cw-search {
    margin-inline-start: auto;
    display: flex;
    align-items: center;
  }
  @media (min-width: 64rem) {
    .cw-docs-nav {
      padding-inline: 2rem;
    }
    .cw-links {
      display: flex;
    }
    .cw-search {
      margin-inline-start: 0;
    }
  }
</style>

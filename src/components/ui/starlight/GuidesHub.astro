---
// One card per manual: a line about it, its chapters, and the live PDF.
// Built only from Starlight's own components (CardGrid, Card, LinkButton), so it
// matches the rest of the guides. Data: src/data_files/guides.json (scripts/sync-guides.py).
import { Card, CardGrid, LinkButton } from '@astrojs/starlight/components';
import manifest from '@data/guides.json';

const icons: Record<string, 'open-book' | 'analytics' | 'notes' | 'setting'> = {
  'instruction-manual': 'open-book',
  'example-measurements': 'analytics',
  physics: 'notes',
  troubleshooting: 'setting',
};
---

<CardGrid>
  {
    manifest.guides.map((g) => (
      <Card title={g.title} icon={icons[g.slug] ?? 'document'}>
        <p>{g.blurb}</p>
        <ol>
          {g.chapters.map((c) => (
            <li>
              <a href={c.url}>{c.title}</a>
            </li>
          ))}
        </ol>
        <LinkButton href={`/pdf/${g.slug}/`} variant="secondary" icon="external" target="_blank" rel="noopener">
          Open the PDF
        </LinkButton>
      </Card>
    ))
  }
</CardGrid>

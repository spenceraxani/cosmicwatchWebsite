---
// Bottom of the docs menu on small screens: the site's own pages, so the main
// navigation is never more than one tap away.
import { navLinks } from '@data/navigation';
import { getCopy } from '@/copy';
import type { Props } from '@astrojs/starlight/props';

const t = getCopy('en');
---

<nav class="cw-mobile-site" aria-label="Site">
  <p>CosmicWatch</p>
  <ul>
    <li><a href="/">Home</a></li>
    {navLinks.map(link => (
      <li><a href={link.path}>{t.nav.labels[link.id]}</a></li>
    ))}
    <li><a class="cw-shop" href="/shop">{t.nav.buy}</a></li>
  </ul>
</nav>

<style>
  .cw-mobile-site {
    border-top: 1px solid var(--sl-color-gray-5);
    padding-block: 1rem 0.5rem;
  }
  .cw-mobile-site p {
    margin: 0 0 0.5rem;
    font-size: var(--sl-text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--sl-color-gray-3);
  }
  .cw-mobile-site ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .cw-mobile-site a {
    color: var(--sl-color-gray-2);
    text-decoration: none;
    font-weight: 500;
  }
  .cw-mobile-site a.cw-shop {
    color: var(--sl-color-accent);
    font-weight: 700;
  }
</style>

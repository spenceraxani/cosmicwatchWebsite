---
// Replaces Starlight's theme provider. Light by default; the moon/sun button in
// the header (ThemeToggle.astro) switches to dark and remembers the choice. The
// same choice applies on the main pages (src/utils/theme.ts).
import { themeScript } from '@utils/theme';
---

<script is:inline set:html={themeScript} />
<script is:inline>
  window.StarlightThemeProvider = { updatePickers() {} };
</script>

---

<span class="site-title flex">
  <a class="main-logo" href="/" aria-label="CosmicWatch home">
    <img class="logo-light" src="/brand/logo-darkblue.png" alt="CosmicWatch" width="1400" height="528" />
    <img class="logo-dark" src="/brand/logo-lightblue.png" alt="CosmicWatch" width="1400" height="528" />
  </a>
  <a class="docs-label" href="/docs/">Docs</a>
</span>

<style>
  .site-title {
    gap: 0.75rem;
    margin-right: 1rem;
  }
  .flex {
    display: flex;
    align-items: center;
  }
  .main-logo img {
    height: 2.1rem;
    width: auto;
  }
  .logo-dark {
    display: none;
  }
  :global([data-theme='dark']) .logo-light {
    display: none;
  }
  :global([data-theme='dark']) .logo-dark {
    display: block;
  }
  .docs-label {
    font-weight: 700;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
    text-decoration: none;
    border-left: 1px solid var(--sl-color-gray-5);
    padding-left: 0.75rem;
  }
  .docs-label:hover {
    color: var(--sl-color-white);
  }
</style>
